services:
  traefik:
    image: traefik:latest
    container_name: traefik
    restart: unless-stopped
    ports:
      - 80:80
      - 443:443
    networks:
      - proxy
    volumes:
      - ./acme.json:/acme.json
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
    labels:
      - traefik.enable=true
      - traefik.http.routers.traefik.rule=Host(`traefik.{{ domain }}`)
      - traefik.http.routers.traefik.service=api@internal
      # Unhandled subdomains (wildcard DNS points them all here): bounce to
      # the 404 plate on the main domain. priority=1 keeps this router last,
      # so explicitly configured subdomains always win over it.
      - traefik.http.routers.catchall.rule=HostRegexp(`{sub:.+}\.{{ domain }}`)
      - traefik.http.routers.catchall.entrypoints=websecure
      - traefik.http.routers.catchall.priority=1
      - traefik.http.routers.catchall.service=noop@internal
      - traefik.http.middlewares.catchall-redirect.redirectregex.regex=.*
      - traefik.http.middlewares.catchall-redirect.redirectregex.replacement=https://{{ domain }}/notfound
      - traefik.http.routers.catchall.middlewares=catchall-redirect

  # Minimal 404 page. Serves https://{{ domain }}/notfound directly and is
  # the fallback target for the bio router's errors middleware (bio-404).
  notfound:
    image: nginx:alpine
    container_name: notfound
    restart: unless-stopped
    networks:
      - proxy
    volumes:
      - ./notfound/root:/usr/share/nginx/html:ro
      - ./notfound/default.conf:/etc/nginx/conf.d/default.conf:ro
    labels:
      - traefik.enable=true
      - traefik.http.routers.notfound.rule=Host(`{{ domain }}`) && Path(`/notfound`)
      - traefik.http.routers.notfound.entrypoints=websecure
      - traefik.http.services.notfound.loadbalancer.server.port=80
      - traefik.http.middlewares.bio-404.errors.status=404
      - traefik.http.middlewares.bio-404.errors.service=notfound@docker
      - traefik.http.middlewares.bio-404.errors.query=/notfound

networks:
  proxy:
    name: proxy
