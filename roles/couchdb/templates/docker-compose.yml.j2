services:
  couchdb:
    image: couchdb
    container_name: couchdb
    restart: unless-stopped
    networks:
      - proxy
    volumes:
     - {{ data_path }}:/opt/couchdb/data
     - {{ app_path }}/config:/opt/couchdb/etc/local.d
     - {{ app_path }}/log:/opt/couchdb/var/log
    environment:
      COUCHDB_USER: {{ gh_secrets.COUCHDB_USER }}
      COUCHDB_PASSWORD: {{ gh_secrets.COUCHDB_PASSWORD }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.couchdb.rule=Host(`couchdb.allrensys.com`)"
      - "traefik.http.routers.couchdb.entrypoints=websecure"
      - "traefik.http.services.couchdb.loadbalancer.server.port=5984"

networks:
  proxy:
    name: proxy
    external: true
